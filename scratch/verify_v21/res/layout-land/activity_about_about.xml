<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:background="@color/black" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:paddingLeft="@dimen/dialogContentLeftMargin" android:paddingTop="@dimen/dialogTitleTopMargin" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <include android:id="@id/id_productType" layout="@layout/include_textview_textview" />
        <include android:id="@id/id_swVersion" layout="@layout/include_textview_textview" />
        <include android:id="@id/id_fwVersion" layout="@layout/include_textview_textview" />
        <include android:id="@id/id_hwVersion" layout="@layout/include_textview_textview" />
        <include android:id="@id/id_right" layout="@layout/include_textview_textview" />
        <include android:id="@id/id_company" layout="@layout/include_textview_textview" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="20.0dp">

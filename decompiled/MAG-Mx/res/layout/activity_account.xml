<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/colorTaskBarBackground" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:background="@drawable/round_corner_shape" android:padding="@dimen/setting_padding" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_margin">
        <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_info" />
        <LinearLayout android:orientation="horizontal" android:paddingTop="@dimen/setting_padding" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_setting_name" android:textAllCaps="false" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/colon" android:textAllCaps="false" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAllCaps="false" android:paddingEnd="@dimen/setting_padding" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:id="@id/setting_account_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:paddingTop="@dimen/setting_padding" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_margin">
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_setting_rank" android:textAllCaps="false" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/colon" android:textAllCaps="false" android:paddingEnd="@dimen/setting_padding" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:id="@id/setting_account_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:paddingTop="@dimen/setting_padding" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_margin">
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_setting_group" android:textAllCaps="false" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/colon" android:textAllCaps="false" android:paddingEnd="@dimen/setting_padding" />
            <TextView android:textSize="@dimen/setting_text_size" android:textColor="@android:color/black" android:id="@id/setting_account_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
